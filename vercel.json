
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/inkorbit-about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/inkorbit-services.html",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/inkorbit-projects.html",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/inkorbit-contact.html",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/inkorbit-about.html"
    },
    {
      "source": "/services",
      "destination": "/inkorbit-services.html"
    },
    {
      "source": "/projects",
      "destination": "/inkorbit-projects.html"
    },
    {
      "source": "/contact",
      "destination": "/inkorbit-contact.html"
    }
  ]
}
